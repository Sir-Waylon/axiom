{
  // Workers + static assets + account API. Secret PEPPER is set in the dashboard (never in this file).
  "name": "axiom",
  "main": "backend/worker.js",
  "compatibility_date": "2024-11-01",
  "assets": { "directory": "./site", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "voltaxis-accounts", "database_id": "35bd48f1-c2b5-45b9-9246-fe530ba0f20d" }],
  "vars": { "GOOGLE_CLIENT_ID": "723722347490-8fs5p0e6jq383fcoat2aicr8eomra5jq.apps.googleusercontent.com" }
}
