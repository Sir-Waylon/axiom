/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; script-src 'self' https://accounts.google.com/gsi/client https://challenges.cloudflare.com https://cdn.jsdelivr.net/npm/katex@0.16.11/; style-src 'self' https://accounts.google.com/gsi/style https://cdn.jsdelivr.net/npm/katex@0.16.11/; img-src 'self' data:; font-src 'self' https://cdn.jsdelivr.net/npm/katex@0.16.11/; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/ https://challenges.cloudflare.com; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests; report-uri /api/csp-report; report-to csp
  Content-Security-Policy-Report-Only: default-src 'none'; script-src 'self' https://accounts.google.com/gsi/client https://challenges.cloudflare.com https://cdn.jsdelivr.net/npm/katex@0.16.11/; style-src 'self' https://accounts.google.com/gsi/style https://cdn.jsdelivr.net/npm/katex@0.16.11/; img-src 'self' data:; font-src 'self' https://cdn.jsdelivr.net/npm/katex@0.16.11/; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/ https://challenges.cloudflare.com; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; report-uri /api/csp-report; report-to csp; require-trusted-types-for 'script'
  Reporting-Endpoints: csp="/api/csp-report"
  X-Permitted-Cross-Domain-Policies: none
  Origin-Agent-Cluster: ?1
/
  Cache-Control: no-cache
/*/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/app/sw.js
  Cache-Control: no-cache
/site.css
  Cache-Control: public, max-age=3600
/s.css
  Cache-Control: public, max-age=3600
/cs.js
  Cache-Control: public, max-age=3600
/try.js
  Cache-Control: public, max-age=3600
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/app/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/app/app.*
  Cache-Control: public, max-age=31536000, immutable
/app/*/app.*
  Cache-Control: public, max-age=31536000, immutable
